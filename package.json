{
  "name": "dnd-store-storefront",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "DND Store — a static clothing storefront with WhatsApp enquiry checkout, built with React, Vite and Tailwind CSS.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "serve": "npm run build && npm run preview",
    "share": "./scripts/share.sh",
    "share:preview": "./scripts/share.sh preview",
    "publish:data": "node scripts/build-store-data.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.7",
    "vite": "^6.3.5"
  }
}
